{
"servers": {
"jira_netapp": {
"url": "https://llm-proxy-api.ai.eng.netapp.com/mcp/jira_netapp",
"type": "http",
"headers": {
"x-litellm-api-key": "Bearer user=${input:username}&key=${input:llmProxyKey}",
"x-mcp-jira_netapp-authorization": "Bearer user=${input:username}&key=${input:jiraToken}"
}
},
"github_onprem": {
"url": "https://llm-proxy-api.ai.eng.netapp.com/mcp/github_onprem",
"type": "http",
"headers": {
"x-litellm-api-key": "Bearer user=${input:username}&key=${input:llmProxyKey}",
"x-mcp-github_onprem-authorization": "${input:githubToken}"
}
}
},
"inputs": [
{
"id": "jani",
"type": "promptString",
"description": "Your SSO username (e.g. jsmith)"
},
{
"id": "llmProxyKey",
"type": "promptString",
"description": "LLM Proxy key",
"password": true
},
{
"id": "jiraToken",
"type": "promptString",
"description": "Jira Personal Access Token",
"password": true
},
{
"id": "githubToken",
"type": "promptString",
"description": "GitHub Personal Access Token",
"password": true
}
]
}